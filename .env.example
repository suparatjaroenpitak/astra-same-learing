# Copy to .env and fill in values. Never commit real credentials.

# ---- Core ----
DATABASE_URL="postgresql://astra:astra@localhost:5432/astra?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NODE_ENV="development"

# ---- AI provider (server-only) ----
# Available providers: openai-compatible | anthropic | mock
# openai-compatible works with OpenAI, Groq, OpenRouter, DeepSeek, local Ollama.
AI_PROVIDER="mock"
AI_MODEL=""
AI_API_KEY=""
AI_BASE_URL=""
AI_MAX_TOKENS_OUT=1200
# Free-tier daily message cap enforced server-side
USAGE_DAILY_LIMIT=30

# ---- Uploads ----
UPLOAD_DIR="./uploads"
UPLOAD_MAX_MB=8

# ---- Releases ----
# HTTPS URLs to published artifacts; leave empty until a real release exists.
ANDROID_APK_URL=""
ANDROID_APK_VERSION=""
ANDROID_APK_SHA256=""
IOS_APPSTORE_URL=""
IOS_TESTFLIGHT_URL=""
